# Cloudflare API 토큰 (Workers Scripts:Edit, R2:Edit 권한 필요)
cloudflare_api_token = "your-cloudflare-api-token"

# Cloudflare 대시보드 오른쪽 Overview에서 확인 가능한 Account ID
cloudflare_account_id = "your-cloudflare-account-id"

# R2 버킷명
r2_bucket_name = "match-history-replays"

# R2 위치 (APAC, WNAM, ENAM, WEUR)
r2_location = "APAC"

# Worker 서비스명
worker_name = "match-history-api"

# 배포 환경
environment = "production"
